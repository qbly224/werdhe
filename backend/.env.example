PORT=3000
NODE_ENV=production

# Base de données (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.xxxx.supabase.co:5432/postgres

# Auth
JWT_SECRET=votre_secret_jwt_ici
FRONTEND_URL=https://werdhe.vercel.app
BACKEND_URL=https://api.werdhe.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.werdhe.com/auth/google/callback

# Cloudinary (photos/documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Notifications push (VAPID / web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contact@werdhe.com

# Mobile Money - MTN
MTN_MODE=sandbox
MTN_API_KEY=
MTN_API_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_MOMO_URL=

# Mobile Money - Orange
ORANGE_MODE=sandbox
ORANGE_MERCHANT_KEY=
ORANGE_MERCHANT_SECRET=
ORANGE_MONEY_URL=
# Secret partagé vérifié sur le webhook /paiements/webhook/orange (obligatoire avant le passage en prod)
ORANGE_WEBHOOK_SECRET=

# Secret partagé vérifié sur le webhook /paiements/webhook/mtn (à configurer aussi côté dashboard marchand MTN)
MTN_WEBHOOK_SECRET=
