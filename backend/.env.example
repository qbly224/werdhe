PORT=3000
NODE_ENV=production

# Base de données (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.xxxx.supabase.co:5432/postgres

# Auth
JWT_SECRET=votre_secret_jwt_ici
FRONTEND_URL=https://werdhe.vercel.app
BACKEND_URL=https://api.werdhe.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.werdhe.com/auth/google/callback

# Cloudinary (photos/documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Notifications push (VAPID / web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contact@werdhe.com

# Djomy (agrégateur Orange Money / MTN MoMo / Kulu / carte) — loyer + abonnements
# Webhook à enregistrer côté dashboard marchand Djomy : https://api.werdhe.com/paiements/webhook/djomy
DJOMY_API_URL=https://sandbox-api.djomy.africa
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
